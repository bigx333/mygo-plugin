{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yxxbc/mygo-plugin/spec/plugin.schema.json",
  "title": "MyGo plugin manifest",
  "description": "plugin.json of a MyGo plugin, the shape MyGo Music plugins already use.",
  "type": "object",
  "required": ["id", "main"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Stable identifier, and the folder the plugin installs as."
    },
    "name": { "type": "string", "description": "What the listener sees." },
    "description": { "type": "string" },
    "version": { "type": "string", "description": "Semantic version, such as 0.2.1." },
    "author": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "main": {
      "type": "string",
      "default": "index.js",
      "description": "Module to run, relative to the plugin folder: .js or .ts."
    },
    "minAppVersion": {
      "type": "string",
      "description": "Oldest host version that can run the plugin, such as 0.1.8."
    },
    "playback": {
      "type": "string",
      "enum": ["stream"],
      "default": "stream",
      "description": "stream: the plugin answers a media URL the host fetches and plays itself."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|(\\*\\.)?[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*)$"
          },
          "description": "Hosts fetch may reach: example.com, *.example.com, or *."
        },
        "process": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "array", "items": { "type": "string" } }
          ],
          "description": "Programs the plugin may start, once granted. This runtime declares but does not start any."
        }
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "help": { "type": "string" },
          "link": { "type": "string", "format": "uri" }
        }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "anyOf": [{ "required": ["page"] }, { "required": ["builtin"] }],
        "properties": {
          "title": { "type": "string" },
          "page": { "type": "string", "description": "Asked of the plugin's browse export." },
          "builtin": { "type": "string", "description": "A page the host draws itself." },
          "icon": { "type": "string", "description": "A name in the host's icon set, not a file." }
        }
      }
    }
  }
}
